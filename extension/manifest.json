{
  "manifest_version": 3,
  "name": "哔哩节流阀 · BiliThrottle",
  "short_name": "BiliThrottle",
  "version": "2.1.0",
  "description": "B 站的油门和刹车：多 CDN 加速、首页净化、无限下滑推荐，再加上像 Claude Code 一样的 5 小时与每周观看额度。",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "哔哩节流阀",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "ui/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*"
      ],
      "js": [
        "src/range-core.js",
        "src/flow-policy.js",
        "src/cdn-resolver.js",
        "src/sidx.js",
        "src/idm-downloader.js",
        "src/native-mse-player.js",
        "src/native-range-transport.js",
        "src/runtime-notices.js",
        "src/diagnostics-core.js",
        "src/settings-panel.js",
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/range-core.js",
        "src/cdn-resolver.js",
        "src/live-core.js",
        "src/runtime-notices.js",
        "src/diagnostics-core.js",
        "src/settings-panel.js",
        "src/live-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "exclude_matches": [
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/range-core.js",
        "src/cdn-resolver.js",
        "src/diagnostics-core.js",
        "src/settings-panel.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "exclude_matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/notification-view.js",
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/notification-view.js",
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "src/home-core.js",
        "src/feed-core.js",
        "src/home-infinite.js",
        "src/home-enhancer.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/focus-core.js",
        "src/focus-guard.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "version_name": "2.1.0 · 油门帮你踩，刹车也帮你踩",
  "optional_permissions": [
    "proxy"
  ],
  "options_page": "ui/options.html"
}
